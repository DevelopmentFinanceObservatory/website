# Copied to the root of dist/ by the build; Workers reads it and does not serve it.

# Next fingerprints everything under _next/static.
/prototypes/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Preview and workers.dev hosts stay out of search. developmentfinance.org
# does not match this pattern.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
