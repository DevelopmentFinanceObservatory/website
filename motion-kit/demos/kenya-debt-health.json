{
    "title": "Kenya: debt service against health aid",
    "question": "Compare Kenya's external debt service with its health aid since 2015, including HIV",
    "messages": [
        {
            "role": "user",
            "text": "Compare Kenya's external debt service with its health aid since 2015, including HIV"
        },
        {
            "role": "bot",
            "text": "This compares two sources, the World Bank's debt statistics and the OECD's aid records, so here is a plan before I fetch anything. Health aid counts purposes 120 and 130, which covers HIV/AIDS."
        },
        {
            "role": "bot",
            "text": "Kenya paid **$5.7bn** in external debt service in 2024, nearly eight times the **$741m** it received in health aid.\n\nIn 2015 the two were close: $890m against $778m. Debt service has risen sixfold since, while health aid, HIV programmes included, has stayed between $600m and $930m a year.",
            "followups": [
                "Show debt service as a share of exports",
                "Break health aid down by donor"
            ],
            "plan": {
                "plan_version_id": "pv_3f8a61e2",
                "version": 1,
                "revision": "rev_7d2e91c4",
                "title": "Kenya's external debt service against its health aid, 2015 to 2024",
                "summary": "Counts Kenya's total external debt service from the World Bank and the health aid it received from the OECD, including HIV, in current US dollars, 2015 to 2024.",
                "steps": [
                    {
                        "label": "Fetch Kenya's external debt service",
                        "gives_answer": false
                    },
                    {
                        "label": "Fetch health aid Kenya received",
                        "gives_answer": false
                    },
                    {
                        "label": "Align both series to a common basis",
                        "gives_answer": false
                    },
                    {
                        "label": "Compare debt service with health aid",
                        "gives_answer": true
                    }
                ],
                "choices": [
                    {
                        "question": "Health aid",
                        "chosen": "Health and population (120, 130)"
                    },
                    {
                        "question": "Aid flow",
                        "chosen": "Gross disbursements"
                    },
                    {
                        "question": "Comparison",
                        "chosen": "Debt service as a multiple of health aid"
                    }
                ],
                "caveats": [
                    "Debt service and health aid come from different providers, so the two series are aligned on year but counted separately."
                ]
            }
        }
    ],
