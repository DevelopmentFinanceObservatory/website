# Dev only: LAN hosts (comma-separated) allowed to open the dev server, for
# phone/tablet testing — e.g. DEV_ORIGINS=192.168.1.20
DEV_ORIGINS=

# DFO engine base URL (Search, Datasets and graph APIs). Required: the server
# refuses to start in production without it, and every call to those APIs
# fails in dev. The dev apis service admits only callers with
# roles/run.invoker, so local work reaches it through a proxy that signs each
# call with your gcloud login (docs/development.md, "Reach the dev APIs"):
#   gcloud run services proxy dfo-dev-apis --region northamerica-northeast1 \
#     --project dev-fin-observatory --port 8083
SEARCH_API_BASE=http://localhost:8083

# Browser-side override for the Search API base. Empty means same-origin
# (the app proxies /api/search/* and /api/datasets/*) — set this only to hit
# a remote engine origin directly from the browser.
NEXT_PUBLIC_SEARCH_API_BASE=

# Studio agent (the dfo-ai harness). The proxy under /api/studio/* sends the
# token as a bearer; without it every turn answers 401. Defaults to a harness
# on localhost:8080 when the base is unset.
STUDIO_API_BASE=
STUDIO_TOKEN=

# Live Studio shares. LIVE_REFRESH_PRINCIPAL is the credential dfo-apis and
# dfo-ai ask of a card refresh. It has the same value on all three services
# and, when deployed, is mounted from Secret Manager by dfo-infra. Empty
# means the Share dialog offers no Live Data and every Studio share is a
# snapshot. LIVE_SHARE_WINDOW_S is how long a refreshed card's answer stands
# before the next viewer asks again (default 300, at most 900).
LIVE_REFRESH_PRINCIPAL=
# LIVE_SHARE_WINDOW_S=300

# Accounts and saved conversations (Postgres). Local development only --
# run `just db-up && just db-migrate` first, then this connects as the
# `website_runtime` role db/migrate-local.ts creates. Deployed services
# don't read DATABASE_URL at all; they connect to Cloud SQL via
# WEBSITE_DB_INSTANCE_CONNECTION_NAME, WEBSITE_DB_USER, and WEBSITE_DB_NAME
# instead (set by dfo-infra). The schema lives in db/schema.ts; migrations
# are generated with `pnpm db:generate`.
DATABASE_URL=postgresql://website_runtime:website_runtime_dev_password@localhost:5433/website

# Better Auth. The secret signs sessions (32+ random bytes, e.g.
# `openssl rand -base64 32`); the URL is this app's own public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign-in providers (Better Auth social sign-in — the only way to get an
# account; there are no password accounts). Each pair is optional: a
# provider without keys simply isn't offered on /login. Callback URL to
# register with every provider:
#   <BETTER_AUTH_URL>/api/auth/callback/<google|github|microsoft>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Feedback form (POST /api/feedback, docs/feedback.md). Submissions are
# stored via DATABASE_URL above; each sink below is optional and off when
# unset. The Slack webhook posts each submission to a channel (deployed:
# mounted from Secret Manager by dfo-infra; values that aren't a
# hooks.slack.com URL mean off). The SMTP block emails submissions to
# FEEDBACK_TO; unused until an email decision exists.
FEEDBACK_SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
FEEDBACK_FROM=
FEEDBACK_TO=

# Sentry (errors, browser + server; docs/analytics.md). Off without a DSN.
# Usage events need no key — they land in the `event` table.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build only, for source-map upload (Sentry -> Settings -> Auth Tokens).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Platform proxy -------------------------------------------------------------
# The DFO APIs and the MCP servers are mirrored 1:1 under this site's domain
# (/api/search|datasets|graph/* -> dfo-apis, /api/studio/* -> dfo-ai, and
# /mcp -> dfo-ai's combined MCP server at /mcp/). /api/* and /mcp have a
# per-IP rate limit, counted in the website database (table limit_counter).
# RATE_LIMIT_WINDOW_S=60
# RATE_LIMIT_API=120
# RATE_LIMIT_PIN=10
# /mcp is higher because a vendor's address can carry many users.
# RATE_LIMIT_MCP=300
# The harness's own token for its MCP server (MCP_API_TOKEN on dfo-ai);
# attached by the proxy so outside MCP clients don't need it. Unset: the
# caller's own Authorization header is passed through.
MCP_API_TOKEN=
# /mcp names each caller to dfo-ai as x-dfo-caller: ip:<digest>, an
# HMAC-SHA-256 of the client IP keyed by this secret (e.g. openssl rand -hex
# 32). If unset, no caller is sent and the site logs one warning.
CALLER_HMAC_KEY=
# Which X-Forwarded-For entry is the client, counted from the right. 0 (the
# default) is the rightmost, the one Cloud Run's front end appends; add one
# for each load balancer in front of the service.
# TRUSTED_PROXY_HOPS=0
# OpenAI's domain-verification token for the app directory. GET
# /.well-known/openai-apps-challenge returns it as plain text, and 404 while
# it is unset.
OPENAI_APPS_CHALLENGE=
