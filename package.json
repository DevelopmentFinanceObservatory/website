{
  "name": "dfo-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test db/test/*.test.ts src/lib/search/test/*.test.ts src/lib/studio/test/*.test.ts src/lib/chat/test/*.test.ts src/lib/proxy/test/*.test.ts src/lib/sources/test/*.test.ts src/lib/test/*.test.ts src/lib/docs/test/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,scss}\"",
    "optimize:svg": "svgo -f src/assets -r",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node db/migrate-local.ts",
    "build:migrate": "esbuild db/migrate.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/migrate.cjs --external:pg-native"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@sentry/nextjs": "^10.75.2",
    "better-auth": "^1.6.29",
    "chart.js": "^4.5.1",
    "classnames": "^2.5.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6",
    "next": "16.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "svgo": "^4.0.2",
    "typescript": "^5"
  }
}
